{
  "id": "propagation.loss-accounting",
  "name": "Loss accounting of obdeect propagation run: photons in = out + dropped by reason (plane, sphere, thinned, weighted, geometry only), weights, and the scattered photons of single scattering (generated = written + dropped)",
  "requires": [
    "obdeect"
  ],
  "commands": [
    {
      "name": "loss-accounting",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.loss_accounting"
      ],
      "timeout": 900
    }
  ],
  "metrics": [
    {"metric": "plane_thinned_balance_error", "expected": 0, "atol": 0},
    {"metric": "plane_thinned_dropped_sum_error", "expected": 0, "atol": 0},
