    {"metric": "plane_thinned_triggered_missing", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_balance_error", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_dropped_sum_error", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_reason_error", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_reaching_error", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_input_count_error", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_triggered_missing", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_cli_mismatch", "expected": 0, "atol": 0},
    {"metric": "plane_weighted_weight_vs_stream_rel", "expected": 0, "atol": 1e-09},
    {"metric": "plane_weighted_weight_vs_expected_rel", "expected": 0, "atol": 1e-09},
