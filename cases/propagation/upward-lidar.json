{
  "id": "propagation.upward-lidar",
  "name": "Upward laser light, single scattering into off-axis telescopes (100 m and 1 km, 20 deg tilt) and a vertical downward control, against the numerical lidar equation (total and per arrival-time bin); scattered photons through the sky to G keep the sign of cz",
  "requires": ["obdeect"],
  "commands": [
    {
      "name": "upward-lidar",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.upward_lidar"],
      "timeout": 1800
    }
  ],
  "metrics": [
    {"metric": "sample_count", "expected": 12000, "atol": 0},
    {"metric": "up_100m_total_yield_pull", "expected": 0, "atol": 4},
    {"metric": "up_1km_total_yield_pull", "expected": 0, "atol": 4},
    {"metric": "down_100m_total_yield_pull", "expected": 0, "atol": 4},
    {"metric": "up_100m_time_chi2_p_below_limit", "expected": 0, "atol": 0},
    {"metric": "up_1km_time_chi2_p_below_limit", "expected": 0, "atol": 0},
    {"metric": "down_100m_time_chi2_p_below_limit", "expected": 0, "atol": 0},
    {"metric": "up_100m_time_max_abs_pull", "expected": 0, "atol": 4},
    {"metric": "up_1km_time_max_abs_pull", "expected": 0, "atol": 4},
    {"metric": "down_100m_time_max_abs_pull", "expected": 0, "atol": 4},
    {"metric": "up_100m_plane_up_count_error", "expected": 0, "atol": 0},
    {"metric": "up_100m_plane_down_count_error", "expected": 0, "atol": 0},
    {"metric": "up_100m_moving_away_error", "expected": 0, "atol": 0},
    {"metric": "up_1km_plane_up_count_error", "expected": 0, "atol": 0},
    {"metric": "up_1km_plane_down_count_error", "expected": 0, "atol": 0},
    {"metric": "up_1km_moving_away_error", "expected": 0, "atol": 0},
    {"metric": "down_100m_plane_up_count_error", "expected": 0, "atol": 0},
    {"metric": "down_100m_plane_down_count_error", "expected": 0, "atol": 0},
    {"metric": "down_100m_moving_away_error", "expected": 0, "atol": 0},
    {"metric": "empty_bin_content", "expected": 0, "atol": 0},
    {"metric": "reference_quadrature_relative", "expected": 0, "atol": 1e-4}
  ]
}
