{
  "id": "propagation.curvature-corsika-tables",
  "name": "CORSIKA CURVED tables (DISTIP, TOFIP) at traced bunches: interpolation consistency (mapping to obdeect in details only)",
  "timeout": 600,
  "commands": [
    {
      "name": "curvature-corsika-tables",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.curvature_corsika_tables"]
    }
  ],
  "metrics": [
    {"metric": "file_count", "expected": 2, "atol": 0},
    {"metric": "bunch_count_positive", "expected": 1, "atol": 0},
    {"metric": "cell_index_mismatch_count", "expected": 0, "atol": 0},
    {"metric": "table_interpolation_max_relative_error", "expected": 0, "atol": 1e-6}
  ]
}
