{
  "id": "propagation.extinction-simtel-table",
  "name": "Real sim_telarray transmission table, telescope path and thinning",
  "commands": [
    {
      "name": "table-interpolation-weighting-and-thinning",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.extinction_reference"]
    }
  ],
  "metrics": [
    {"metric": "wavelength_count", "expected": 9, "atol": 0},
    {"metric": "height_count", "expected": 5, "atol": 0},
    {"metric": "zenith_count", "expected": 4, "atol": 0},
    {"metric": "telescope_elevation_count", "expected": 2, "atol": 0},
    {"metric": "path_length_count", "expected": 2, "atol": 0},
    {"metric": "source_rows_ignored_above_api_wavelength_range", "expected": 1, "atol": 0},
    {"metric": "weighted_table_max_absolute_error", "expected": 0, "atol": 1e-6},
    {"metric": "weighted_column_max_absolute_error", "expected": 0, "atol": 1e-6},
    {"metric": "telescope_depth_max_absolute_error", "expected": 0, "atol": 1e-12},
    {"metric": "thinning_count_residual_sigma", "expected": 0, "atol": 5}
  ]
}
