{
  "id": "propagation.curvature-corsika-geometry",
  "name": "CORSIKA CURVED geometry (65 and 75 deg): emission altitude, detector-frame directions, bunch format, headers",
  "timeout": 1800,
  "commands": [
    {
      "name": "curved-corsika-files",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.curvature_corsika_geometry"]
    }
  ],
  "metrics": [
    {"metric": "file_count", "expected": 2, "atol": 0},
    {"metric": "median_slant_depth_outside_range_count", "expected": 0, "atol": 0},
    {"metric": "mean_zenith_error_max_deg", "expected": 0, "atol": 0.5},
    {"metric": "long_format_violation_count", "expected": 0, "atol": 0},
    {"metric": "header_flag_mismatch_count", "expected": 0, "atol": 0},
    {"metric": "curved_log_missing_count", "expected": 0, "atol": 0}
  ]
}
