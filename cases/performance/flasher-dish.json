{
  "id": "performance.flasher-dish",
  "name": "flasher-dish: LightEmission -> sim_telarray versus obdeect sources -> propagation -> stream -> sim_telarray, matched photon counts (report only)",
  "requires": ["obdeect", "python3"],
  "commands": [
    {
      "name": "measure-flasher-dish",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.performance_chain", "flasher-dish"],
      "timeout": 7200
    }
  ],
  "metrics": [
    {"metric": "reference_completed", "expected": 1, "atol": 0},
    {"metric": "candidate_threads1_completed", "expected": 1, "atol": 0}
  ]
}
