{
  "id": "ledger.efficiency-tamper",
  "name": "Efficiency ledger: tampered chains (missing atmosphere, factor pending/applied twice, envelope undeclared, backward state, angular t0) must be rejected with a message naming the factor; positive controls accepted",
  "requires": [
    "obdeect"
  ],
  "inputs": [
    "/validation/inputs/gamma-20deg-20-100GeV.iact",
    "/validation/inputs/gamma-20deg-20-100GeV.corsika.log",
    "/reference/cfg/common/atm_trans_2156_1_3_2_0_0_0.1_0.1.dat"
  ],
  "commands": [
    {
      "name": "ledger-tamper",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.ledger_tamper"
      ],
      "timeout": 1800
    }
  ],
