{
  "id": "sources.led-reference",
  "commands": [
    {
      "name": "compare-led-reference",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.led_reference"
      ]
    }
  ],
  "requires": [
    "obdeect",
    "pixled",
    "python3"
  ],
  "metrics": [
    {
      "metric": "native_event_count",
      "expected": 3,
      "atol": 0
    },
    {
      "metric": "reference_event_count",
      "expected": 3,
      "atol": 0
    },
    {
      "metric": "native_photon_count",
      "expected": 60,
      "atol": 0
    },
    {
      "metric": "reference_photon_count",
      "expected": 60,
      "atol": 0
    },
    {
      "metric": "event_count_delta",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "photon_count_delta",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "max_event_photon_delta",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "position_centroid_delta_cm",
      "expected": 0,
      "atol": 0.0001
    }
  ]
}
