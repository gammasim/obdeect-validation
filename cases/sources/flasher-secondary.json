{
  "id": "sources.flasher-secondary",
  "name": "Secondary flasher versus ff-gct (stage 1 emission)",
  "commands": [
    {
      "name": "compare-flasher-secondary",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.source_camera",
        "flasher-secondary"
      ],
      "timeout": 1800
    }
  ],
  "requires": [
    "obdeect",
    "ff-gct",
    "python3"
  ],
  "metrics": [
    {
      "metric": "native_event_count",
      "expected": 1,
      "atol": 0
    },
    {
      "metric": "reference_event_count",
      "expected": 1,
      "atol": 0
    },
    {
      "metric": "event_count_delta",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "photon_ratio_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cx_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cy_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cx_ks_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cy_ks_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "t_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "t_rms_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "wavelength_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "wavelength_rms_limit_exceeded",
      "expected": 0,
      "atol": 0
    }
  ]
}
