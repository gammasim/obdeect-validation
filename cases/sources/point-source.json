{
  "id": "sources.point-source",
  "name": "Point source versus xyzls (emission; camera stage in details.json)",
  "commands": [
    {
      "name": "compare-point-source",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.source_camera",
        "point-source"
      ],
      "timeout": 1800
    }
  ],
  "requires": [
    "obdeect",
    "xyzls",
    "python3"
  ],
  "metrics": [
    {
      "metric": "native_event_count",
      "expected": 30,
      "atol": 0
    },
    {
      "metric": "reference_event_count",
      "expected": 30,
      "atol": 0
    },
    {
      "metric": "event_count_delta",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "photon_ratio_accepted_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cx_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cy_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cx_ks_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "cy_ks_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "t_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "t_rms_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "wavelength_mean_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "wavelength_rms_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "camera_pe_ratio_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "camera_image_chi2_limit_exceeded",
      "expected": 0,
      "atol": 0
    }
  ]
}
