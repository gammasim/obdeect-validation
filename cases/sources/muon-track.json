{
  "id": "sources.muon-track",
  "name": "Muon track versus fake-muon: yield, Cherenkov angle, spectrum, time, camera p.e.",
  "requires": [
    "obdeect",
    "fake-muon",
    "python3"
  ],
  "commands": [
    {
      "name": "compare-muon-track",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.source_comparison",
        "muon-track"
      ],
      "timeout": 1800
    }
  ],
