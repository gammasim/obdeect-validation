{
  "id": "chain.optics-bypass1-60deg",
  "name": "CORSIKA -> obdeect trace-stream -> sim_telarray Bypass_Optics (candidate) vs direct sim_telarray, LSTN-01 North, zenith 60 deg, N->E azimuth 180 deg, gamma, unit atmosphere NOTE: energy range 300-5000 GeV differs from chain.optics-bypass1-40deg (100-3000 GeV), so the zenith dependence of the two cases is not isolated.",
  "requires": [
    "obdeect",
    "simtools-generate-array-config"
  ],
  "inputs": [
    "{validation}/inputs/gamma-60deg-300-5000GeV.iact"
  ],
  "commands": [
    {
      "name": "generate-sim_telarray-config",
      "argv": [
        "simtools-generate-array-config",
        "--site",
        "North",
        "--array_element_list",
        "LSTN-01",
        "--model_version",
        "7.0.0",
        "--simulation_models_path",
        "/models",
        "--output_path",
        "cfg"
      ],
      "timeout": 900
    },
    {
      "name": "chain-optics-60deg",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.chain_optics",
        "--config",
        "cfg/model/7.0.0/CTAO.cfg",
        "--telescope",
        "LSTN-01",
        "--site",
        "North",
        "--model-version",
        "7.0.0",
        "--input",
        "{validation}/inputs/gamma-60deg-300-5000GeV.iact",
        "--azimuth",
        "180"
      ],
      "timeout": 1200
    }
  ],
  "metrics": [
    {
      "metric": "candidate_pipeline_complete",
      "expected": 1,
      "atol": 0
    },
    {
      "metric": "photoelectron_bias_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "image_shape_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "arrival_time_bias_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "trigger_probability_limit_exceeded",
      "expected": 0,
      "atol": 0
    }
  ]
}
