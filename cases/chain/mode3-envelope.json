{
  "id": "chain.mode3-envelope",
  "name": "Production chain: CORSIKA -> obdeect propagation (QE envelope thinning) -> trace-stream -> to-simtel -> sim_telarray Bypass_Optics=3 (camera only, scaled QE table) vs direct sim_telarray Bypass_Optics=0, LSTN-01 7.0.0, production atmosphere",
  "requires": ["obdeect", "simtools-generate-array-config", "/opt/mode3/sim_telarray"],
  "commands": [
    {
      "name": "generate-sim_telarray-config",
      "argv": ["simtools-generate-array-config", "--site", "North", "--array_element_list", "LSTN-01",
               "--model_version", "7.0.0", "--simulation_models_path", "/models", "--output_path", "cfg"],
      "timeout": 900
    },
    {
      "name": "chain-mode3-envelope",
      "argv": ["{python}", "-m", "obdeect_validation.adapters.chain_mode3",
               "--config", "cfg/model/7.0.0/CTAO.cfg",
               "--candidate-binary", "/opt/mode3/sim_telarray"],
      "timeout": 3600
    }
  ],
  "metrics": [
    {"metric": "candidate_pipeline_complete", "expected": 1, "atol": 0},
    {"metric": "reference_camera_events", "expected": 100, "atol": 0},
    {"metric": "candidate_camera_events", "expected": 100, "atol": 0},
    {"metric": "camera_event_id_delta", "expected": 0, "atol": 0},
    {"metric": "photoelectron_bias_limit_exceeded", "expected": 0, "atol": 0},
    {"metric": "image_shape_limit_exceeded", "expected": 0, "atol": 0},
    {"metric": "arrival_time_bias_limit_exceeded", "expected": 0, "atol": 0},
    {"metric": "trigger_pattern_mismatches", "expected": 0, "atol": 0},
    {"metric": "thinned_photons_limit_exceeded", "expected": 0, "atol": 0},
    {"metric": "atmosphere_log_failures", "expected": 0, "atol": 0},
    {"metric": "qe_table_failures", "expected": 0, "atol": 0},
    {"metric": "bypass_mode_failures", "expected": 0, "atol": 0}
  ]
}
