{
  "id": "chain.optics-bypass1",
  "name": "CORSIKA -> obdeect trace-stream -> sim_telarray camera (Bypass_Optics=1) vs direct sim_telarray, matched LSTN-01 7.0.0 model, unit atmosphere",
  "requires": [
    "obdeect",
    "simtools-generate-array-config"
  ],
  "commands": [
    {
      "name": "generate-sim_telarray-config",
      "argv": [
        "simtools-generate-array-config",
        "--site",
        "North",
        "--array_element_list",
        "LSTN-01",
        "--model_version",
        "7.0.0",
        "--simulation_models_path",
        "/models",
        "--output_path",
        "cfg"
      ],
      "timeout": 900
    },
    {
      "name": "chain-optics-bypass1",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.chain_optics",
        "--config",
        "cfg/model/7.0.0/CTAO.cfg"
      ],
      "timeout": 1200
    }
  ],
  "metrics": [
    {
      "metric": "candidate_pipeline_complete",
      "expected": 1,
      "atol": 0
    },
    {
      "metric": "photoelectron_bias_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "image_shape_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "arrival_time_bias_limit_exceeded",
      "expected": 0,
      "atol": 0
    },
    {
      "metric": "trigger_probability_limit_exceeded",
      "expected": 0,
      "atol": 0
    }
  ]
}
