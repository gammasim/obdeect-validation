{
  "id": "robustness.stream-damage",
  "name": "Robustness: truncated, corrupt, version-mismatched, empty-event, zero-photon-telescope and no-event streams through the pipe chain; early consumer exit",
  "requires": [
    "obdeect"
  ],
  "inputs": [
    "/validation/inputs/gamma-20deg-20-100GeV.iact",
    "/validation/inputs/gamma-20deg-20-100GeV.corsika.log",
    "/reference/cfg/common/atm_trans_2156_1_3_2_0_0_0.1_0.1.dat"
  ],
  "commands": [
    {
      "name": "robustness-stream",
      "argv": [
        "{python}",
        "-m",
        "obdeect_validation.adapters.robustness_stream"
      ],
      "timeout": 1800
    }
  ],
  "metrics": [
